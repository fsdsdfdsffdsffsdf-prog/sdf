# ==============================================================================
# AntiGraffiti AI - Environment Variables
# ==============================================================================

# Application Settings
APP_NAME=AntiGraffiti AI
APP_ENV=production
APP_DEBUG=false
SECRET_KEY=change_this_to_a_super_secret_64_char_random_string_in_production
ALLOWED_HOSTS=*

# Database (PostgreSQL 16+)
DATABASE_URL=postgresql+asyncpg://antigraffiti_user:antigraffiti_password@postgres:5432/antigraffiti_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis Cache and Background Task Broker
REDIS_URL=redis://redis:6379/0

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_EXAMPLE
TELEGRAM_BOT_USERNAME=antigraffiti_ai_bot

# Webhook Configuration (HTTPS Only - No Long Polling)
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PATH=/webhook/telegram
WEBHOOK_SECRET=generate_a_random_32_to_64_character_hex_or_alphanumeric_secret

# AI Vision Service (OpenAI API)
OPENAI_API_KEY=sk-proj-example_api_key_must_be_set_here_do_not_commit_real_keys
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=3

# Initial Super Admin Credentials (Created automatically on startup if not exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SuperStrongAdminPassword2026!
ADMIN_EMAIL=admin@antigraffiti.local

# Storage Configuration
STORAGE_PATH=/app/storage
MAX_PHOTO_SIZE_BYTES=10485760

# Reverse Geocoding (Nominatim / Custom service)
GEOCODING_USER_AGENT=AntiGraffitiAI/1.0 (urban_cleanup_initiative@local)
